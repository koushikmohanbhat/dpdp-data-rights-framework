# Copy to terraform.tfvars (git-ignored). Use a NON-PRODUCTION account.
region = "ap-south-1"

# owner/repo of the fork or copy that runs .github/workflows/integration-aws.yml
# Leave empty to run the tests only from your machine.
github_repository  = "your-org/dpdp-data-rights-framework"
github_environment = "aws-integration"

# Repositories created, renamed or transferred after 15 July 2026 get GitHub's immutable OIDC subject
# (owner@id/repo@id). Set both IDs for those:  gh api repos/OWNER/REPO --jq '.owner.id, .id'
# github_owner_id      = 12345678
# github_repository_id = 123456789

# Set false if the account already has the GitHub OIDC provider
create_github_oidc_provider = true

# IAM users/roles allowed to assume the test role for local runs (optional)
local_test_principals = []
